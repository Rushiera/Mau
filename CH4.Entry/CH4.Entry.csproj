<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CH4.Entry</AssemblyName>
    <RootNamespace>CH4</RootNamespace>
    <Version>0.51.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mau.Runtime\Mau.Runtime.csproj" />
    <ProjectReference Include="..\Mau.Providers\Mau.Providers.csproj" />
    <!-- B3 mau.* 工具实装——组翻译共享服务（MauProjFile/MauGroupBuilder）自 Mau.Development 引用 -->
    <ProjectReference Include="..\Mau.Development\Mau.Development.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- P6 外观层 HTTP——Kestrel + Minimal API（FrameworkReference = 运行时自带，非第三方 NuGet 依赖） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- P6 外观层静态页——复制到输出目录（HttpHost.ServeIndex 从 AppContext.BaseDirectory/html/ 读取） -->
    <None Include="html\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
