// 工具循环——claim → exec → complete（ShellCat 原子编排形态提炼；oa/shell/data 积木迁走——probe 系占位）
§ 'S_Loop' = { 'WaitWork', 'Executing', 'Closing', 'Done' }
§ 'P_Claimed' ⇐
§ 'P_CloseOk' ⇐
§ 'P_Q_Work' ↻ [1]: 'probe.sink'["work", 0] > @work
§ 'T_Claim' : @work & 'S_Loop' = 'WaitWork' → 'probe.source'[0] | 'S_Loop' = 'Executing' | 'S_Loop' = 'WaitWork'
§ 'T_Exec' [par] : 'P_Claimed' & 'S_Loop' = 'Executing' → 'probe.sink_slow'["run", 0] | 'S_Loop' = 'Closing' | 'S_Loop' = 'Done'
§ 'T_Close' : 'P_CloseOk' & 'S_Loop' = 'Closing' → 'probe.sink'["close", 0] | 'S_Loop' = 'WaitWork' | 'S_Loop' = 'Done'
