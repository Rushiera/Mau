<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mau.Audio</RootNamespace>
    <AssemblyName>Mau.Audio</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NAudio.Wasapi 面向 net9.0（Windows-only at runtime，[SupportedOSPlatform("windows")]）；
         本工程 TFM 对齐 FL 生成物（net10.0），平台分析器告警在此收敛（design-mau-audio §九-3） -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 音频播放能力——PCM WAV 走 Windows 原生（design-mau-audio §二） -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 观测出声——失败可见（LogStore） -->
    <ProjectReference Include="..\Mau.Runtime\Mau.Runtime.csproj" />
    <!-- 契约面——IAudioService（实现不泄漏 NAudio 类型） -->
    <ProjectReference Include="..\Mau.Contracts\Mau.Contracts.csproj" />
  </ItemGroup>

</Project>
