{
  "_说明": "配置群 schema 模板——复制为 Data/config/schema.json；声明项 = 配置面唯一契约（默认值/敏感/可写/值域——config.* 工具与 serve 写通道共用）",
  "items": [
    { "key": "llm.thinking", "file": "llm.cfg", "default": "enabled", "sensitive": false, "writable": false, "desc": "思考模式" },
    { "key": "llm.reasoning_effort", "file": "llm.cfg", "default": "medium", "sensitive": false, "writable": false, "desc": "思考强度" },
    { "key": "http.port", "file": "llm.cfg", "default": "8080", "sensitive": false, "writable": false, "desc": "HTTP 端口" },
    { "key": "llm.cache_isolation", "file": "llm.cfg", "default": "cat", "sensitive": false, "writable": true, "type": "string", "values": ["cat", "session", "off"], "desc": "LLM 缓存隔离粒度（cat=按猫 / session=按会话 / off=不隔离）" },
    { "key": "ui.chat_font_size", "file": "ui.cfg", "default": "14", "sensitive": false, "writable": true, "type": "int", "min": "8", "max": "32", "desc": "对话区字体大小 px" },
    { "key": "app.autostart", "file": "app.cfg", "default": "false", "sensitive": false, "writable": true, "type": "bool", "desc": "开机自启（注册 HKCU Run）" },
    { "key": "app.round_notify", "file": "app.cfg", "default": "true", "sensitive": false, "writable": true, "type": "bool", "desc": "本轮结束系统通知（托盘 BalloonTip）" },
    { "key": "search.api_config_id", "file": "search.cfg", "default": "", "sensitive": false, "writable": true, "desc": "搜索 API 池配置 ID（未配置=搜索不可用）" },
    { "key": "search.endpoint", "file": "search.cfg", "default": "", "sensitive": false, "writable": true, "desc": "搜索端点（含 /anthropic/ 走 Anthropic 消息协议；空=池配置推导 /responses；示例 https://api.deepseek.com/anthropic/v1/messages）" },
    { "key": "search.model", "file": "search.cfg", "default": "", "sensitive": false, "writable": true, "desc": "搜索模型（空=池配置默认模型）" },
    { "key": "search.timeout_ms", "file": "search.cfg", "default": "120000", "sensitive": false, "writable": true, "type": "int", "min": "1000", "max": "120000", "desc": "搜索超时毫秒（上限 120 秒——与工具执行层统一口径）" },
    { "key": "vision.api_config_id", "file": "vision.cfg", "default": "", "sensitive": false, "writable": true, "desc": "视觉 API 池配置 ID（未配置=识图不可用）" },
    { "key": "vision.endpoint", "file": "vision.cfg", "default": "", "sensitive": false, "writable": true, "desc": "视觉端点（空=池配置推导 /chat/completions；示例 https://api.deepseek.com/chat/completions）" },
    { "key": "vision.model", "file": "vision.cfg", "default": "", "sensitive": false, "writable": true, "desc": "视觉模型（空=池配置默认模型）" },
    { "key": "vision.detail", "file": "vision.cfg", "default": "auto", "sensitive": false, "writable": true, "desc": "图片细节（low/high/original/auto）" },
    { "key": "vision.timeout_ms", "file": "vision.cfg", "default": "120000", "sensitive": false, "writable": true, "type": "int", "min": "1000", "max": "120000", "desc": "视觉超时毫秒（上限 120 秒——与工具执行层统一口径）" },
    { "key": "ps.pwsh_path", "file": "ps.cfg", "default": "", "sensitive": false, "writable": true, "desc": "PowerShell 7 可执行路径（pwsh.exe 全路径；空=未配置——powershell7 工具明示不可用）" }
  ]
}