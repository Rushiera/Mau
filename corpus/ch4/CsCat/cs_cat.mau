§ 'T_MemberClaim' : @mbOpen & 'S_Member' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-member"] > @mbOffice | 'S_Member' = 'Claimed' | 'S_Member' = 'Idle'
