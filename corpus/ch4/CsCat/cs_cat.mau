// cs_cat.mau —— CsCat 语料（CH4 R0.2 工具组 Flow 化——CS 编码工具域独立 Flow，原 DevCat 分部拆分）
// 角色：工具组 Flow——认领 TOOL 域 cs-* 11 工具（check/build/list/read/find_ref/patch/member/comment/dead/comment_check/format）
// 单级 OA 单：Dog Post → 本 Flow 11 线认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名；载荷 key "args" = 整包工具参数 JSON
// 无值分支：每工具一条认领线，工具名写死在候选列表（信号即解析结果——分支拓扑靠多传感器）
// 数据面：@ckOffice 等私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型：全部主线程同步（Roslyn 语法树操作受控短 IO）
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）

// ── 状态机（10 线——每线独立生命周期）──
§ 'S_Check' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Build' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_List' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CsRead' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_FindRef' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Patch' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Member' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Comment' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Dead' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CommentCheck' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Format' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// T_Init：启动初始化自述——Init → Idle 首帧写"空闲待命"（R0.2 外观层：启动即有自述横幅）
§ 'T_Init' : 'S_Check' = 'Init' → 'self.desc'["空闲待命", "", ""] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'

// ── 主动传感器壳——11 线各自探测（officeName = 完整工具名）──
§ 'P_CheckOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-check"] > @ckOpen
§ 'P_BuildOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-build"] > @buOpen
§ 'P_ListOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-list"] > @liOpen
§ 'P_CsReadOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-read"] > @csOpen
§ 'P_FindRefOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-find_ref"] > @frOpen
§ 'P_PatchOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-patch"] > @ptOpen
§ 'P_MemberOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-member"] > @mbOpen
§ 'P_CommentOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-comment"] > @cmOpen
§ 'P_DeadOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-dead"] > @ddOpen
§ 'P_CommentCheckOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-comment_check"] > @ccOpen
§ 'P_FormatOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-format"] > @fmOpen

// ══════════════ cs-check 线 ══════════════
§ 'T_CheckClaim' : @ckOpen & 'S_Check' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-check"] > @ckOffice | 'S_Check' = 'Claimed' | 'S_Check' = 'Idle'
§ 'T_CheckArgs' : 'S_Check' = 'Claimed' → 'oa.get_str'[@ckOffice, "args"] > @ckArgs | 'S_Check' = 'Ready' | 'S_Check' = 'Failed'
§ 'T_CheckExec' : 'S_Check' = 'Ready' → 'csharp.bridge'["check", @ckArgs] > @ckRes | 'self.desc'["cs-check 执行中", "", ""] | 'S_Check' = 'Done' | 'S_Check' = 'Failed'
§ 'T_CheckReply' : 'S_Check' = 'Done' → 'oa.complete_str'[@ckOffice, @ckRes] | 'self.desc'["空闲待命", "", ""] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'
§ 'T_CheckAbort' : 'S_Check' = 'Failed' → 'oa.complete_str'[@ckOffice, @ckRes] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'

// ══════════════ cs-build 线 ══════════════
§ 'T_BuildClaim' : @buOpen & 'S_Build' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-build"] > @buOffice | 'S_Build' = 'Claimed' | 'S_Build' = 'Idle'
§ 'T_BuildArgs' : 'S_Build' = 'Claimed' → 'oa.get_str'[@buOffice, "args"] > @buArgs | 'S_Build' = 'Ready' | 'S_Build' = 'Failed'
§ 'T_BuildExec' : 'S_Build' = 'Ready' → 'csharp.bridge'["build", @buArgs] > @buRes | 'self.desc'["cs-build 执行中", "", ""] | 'S_Build' = 'Done' | 'S_Build' = 'Failed'
§ 'T_BuildReply' : 'S_Build' = 'Done' → 'oa.complete_str'[@buOffice, @buRes] | 'self.desc'["空闲待命", "", ""] | 'S_Build' = 'Idle' | 'S_Build' = 'Idle'
§ 'T_BuildAbort' : 'S_Build' = 'Failed' → 'oa.complete_str'[@buOffice, @buRes] | 'S_Build' = 'Idle' | 'S_Build' = 'Idle'

// ══════════════ cs-list 线 ══════════════
§ 'T_ListClaim' : @liOpen & 'S_List' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-list"] > @liOffice | 'S_List' = 'Claimed' | 'S_List' = 'Idle'
§ 'T_ListArgs' : 'S_List' = 'Claimed' → 'oa.get_str'[@liOffice, "args"] > @liArgs | 'S_List' = 'Ready' | 'S_List' = 'Failed'
§ 'T_ListExec' : 'S_List' = 'Ready' → 'csharp.bridge'["list", @liArgs] > @liRes | 'self.desc'["cs-list 执行中", "", ""] | 'S_List' = 'Done' | 'S_List' = 'Failed'
§ 'T_ListReply' : 'S_List' = 'Done' → 'oa.complete_str'[@liOffice, @liRes] | 'self.desc'["空闲待命", "", ""] | 'S_List' = 'Idle' | 'S_List' = 'Idle'
§ 'T_ListAbort' : 'S_List' = 'Failed' → 'oa.complete_str'[@liOffice, @liRes] | 'S_List' = 'Idle' | 'S_List' = 'Idle'

// ══════════════ cs-read 线 ══════════════
§ 'T_CsReadClaim' : @csOpen & 'S_CsRead' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-read"] > @csOffice | 'S_CsRead' = 'Claimed' | 'S_CsRead' = 'Idle'
§ 'T_CsReadArgs' : 'S_CsRead' = 'Claimed' → 'oa.get_str'[@csOffice, "args"] > @csArgs | 'S_CsRead' = 'Ready' | 'S_CsRead' = 'Failed'
§ 'T_CsReadExec' : 'S_CsRead' = 'Ready' → 'csharp.bridge'["read", @csArgs] > @csRes | 'self.desc'["cs-read 执行中", "", ""] | 'S_CsRead' = 'Done' | 'S_CsRead' = 'Failed'
§ 'T_CsReadReply' : 'S_CsRead' = 'Done' → 'oa.complete_str'[@csOffice, @csRes] | 'self.desc'["空闲待命", "", ""] | 'S_CsRead' = 'Idle' | 'S_CsRead' = 'Idle'
§ 'T_CsReadAbort' : 'S_CsRead' = 'Failed' → 'oa.complete_str'[@csOffice, @csRes] | 'S_CsRead' = 'Idle' | 'S_CsRead' = 'Idle'

// ══════════════ cs-find_ref 线 ══════════════
§ 'T_FindRefClaim' : @frOpen & 'S_FindRef' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-find_ref"] > @frOffice | 'S_FindRef' = 'Claimed' | 'S_FindRef' = 'Idle'
§ 'T_FindRefArgs' : 'S_FindRef' = 'Claimed' → 'oa.get_str'[@frOffice, "args"] > @frArgs | 'S_FindRef' = 'Ready' | 'S_FindRef' = 'Failed'
§ 'T_FindRefExec' : 'S_FindRef' = 'Ready' → 'csharp.bridge'["find_ref", @frArgs] > @frRes | 'self.desc'["cs-find_ref 执行中", "", ""] | 'S_FindRef' = 'Done' | 'S_FindRef' = 'Failed'
§ 'T_FindRefReply' : 'S_FindRef' = 'Done' → 'oa.complete_str'[@frOffice, @frRes] | 'self.desc'["空闲待命", "", ""] | 'S_FindRef' = 'Idle' | 'S_FindRef' = 'Idle'
§ 'T_FindRefAbort' : 'S_FindRef' = 'Failed' → 'oa.complete_str'[@frOffice, @frRes] | 'S_FindRef' = 'Idle' | 'S_FindRef' = 'Idle'

