§ 'T_FormatArgs' : 'S_Format' = 'Claimed' → 'oa.get_str'[@fmOffice, "args"] > @fmArgs | 'S_Format' = 'Ready' | 'S_Format' = 'Failed'
§ 'T_FormatExec' : 'S_Format' = 'Ready' → 'csharp.bridge'["format", @fmArgs] > @fmRes | 'self.desc'["cs-format 执行中", "", ""] | 'S_Format' = 'Done' | 'S_Format' = 'Failed'
