// io_test_cat.mau —— IOTestCat 语料（CH4 第一轮 P2a）
// 角色：ReadText 单参消费者——探测接单 → 读载荷 → file.read → 回执 → 复位
// 单参验证：path 经 OA 载荷传输（ToolTestCat set_str → 本语料 get_str）
// 数据面：盒子 Key——@office/@path/@content 私有（FlowId 隔离）；@anyOpen 探测落盒
// 线程模型：全部主线程同步（受控短 IO）；探测壳走宿主协程列表
// 观测：trace 埋点生成器内建 + OA 机制专属 Log + 盒子 DataBox 位置（sys.box 直读）

// ── 状态机 ──
§ 'S_Io' = { 'Idle', 'Claimed', 'Reading', 'Done', 'Failed' }

// ── 主动传感器壳——独立起点：探测（纯只读判断积木）→ bool 落盒 @anyOpen ──
§ 'P_AnyOpen' ↻ [1]: 'oa.is_open'["TOOL", "ReadText"] > @anyOpen

// ── 导线链 ──

// T_Claim：盒子判真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_Claim' : @anyOpen & 'S_Io' = 'Idle' → 'oa.claim_next_simple'["TOOL", "ReadText"] > @office | 'S_Io' = 'Claimed' | 'S_Io' = 'Idle'

// T_Read：读工单载荷 path（单参传输验证点）
§ 'T_Read' : 'S_Io' = 'Claimed' → 'oa.get_str'[@office, "path"] > @path | 'S_Io' = 'Reading' | 'S_Io' = 'Failed'

// T_Exec：读取文件（ERR| 错误文本进 @content——失败可见性）
§ 'T_Exec' : 'S_Io' = 'Reading' → 'file.read'[@path] > @content | 'S_Io' = 'Done' | 'S_Io' = 'Failed'

// T_Reply：成功回执（result=文件内容）
§ 'T_Reply' : 'S_Io' = 'Done' → 'oa.complete_str'[@office, @content] | 'S_Io' = 'Idle' | 'S_Io' = 'Idle'

// T_Abort：失败回执（@content 空或 ERR| 文本——失败侧也回执，ToolTestCat 可见失败原因）
§ 'T_Abort' : 'S_Io' = 'Failed' → 'oa.complete_str'[@office, @content] | 'S_Io' = 'Idle' | 'S_Io' = 'Idle'
