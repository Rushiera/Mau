// dev_cat.mau —— DevCat 语料（CH4 P8 二期——OA 工具执行 Cat）
// 角色：Dog 工单执行方——认领 TOOL 域 7 工具（text.read/write/append/replace + mau.verify/gen/proj）
// 单级 OA 单：Dog（宿主 ToolOrderDog 实体）Post → 本语料 7 线认领执行 → complete_str 回执
// 多级预留：Relist 后单回 Open，本语料（或其他执行 Cat）可再次认领——线对链路无感
// 载荷协议：officeName = 工具名；载荷 key "args" = 整包工具参数 JSON（宿主发单落盒——CH2 Dog 机制验证格式）
// 无值分支：每工具一条认领线，工具名写死在候选列表（信号即解析结果——分支拓扑靠多传感器）
// 数据面：@rdOffice 等私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型：全部主线程同步（受控短 IO）；mau.proj dotnet build 长耗时阻塞主线程（与一期直执等价——P9 后台域清偿）
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）+ log.write TOOL 类别

// ── 状态机（7 线——每线独立生命周期）──
§ 'S_Read' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Write' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Append' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Replace' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Verify' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Gen' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Proj' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// ── 主动传感器壳——7 线各自探测（纯只读判断积木 → bool 落盒）──
§ 'P_ReadOpen' ↻ [1]: 'oa.is_open'["TOOL", "text.read"] > @rdOpen
§ 'P_WriteOpen' ↻ [1]: 'oa.is_open'["TOOL", "text.write"] > @wrOpen
§ 'P_AppendOpen' ↻ [1]: 'oa.is_open'["TOOL", "text.append"] > @apOpen
§ 'P_ReplaceOpen' ↻ [1]: 'oa.is_open'["TOOL", "text.replace"] > @rpOpen
§ 'P_VerifyOpen' ↻ [1]: 'oa.is_open'["TOOL", "mau.verify"] > @vfOpen
§ 'P_GenOpen' ↻ [1]: 'oa.is_open'["TOOL", "mau.gen"] > @gnOpen
§ 'P_ProjOpen' ↻ [1]: 'oa.is_open'["TOOL", "mau.proj"] > @pjOpen

// ══════════════ text.read 线 ══════════════

// T_ReadClaim：探测真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_ReadClaim' : @rdOpen & 'S_Read' = 'Idle' → 'oa.claim_next_simple'["TOOL", "text.read"] > @rdOffice | 'S_Read' = 'Claimed' | 'S_Read' = 'Idle'

// T_ReadArgs：读载荷 args（整包工具参数 JSON）
§ 'T_ReadArgs' : 'S_Read' = 'Claimed' → 'oa.get_str'[@rdOffice, "args"] > @rdArgs | 'S_Read' = 'Ready' | 'S_Read' = 'Failed'

// T_ReadExec：执行积木（argsJson 整包——积木内部解析；失败侧 ERR 文本也在 @rdRes）
§ 'T_ReadExec' : 'S_Read' = 'Ready' → 'text.read'[@rdArgs] > @rdRes | 'S_Read' = 'Done' | 'S_Read' = 'Failed'

// T_ReadReply：成功回执（result=文件内容）
§ 'T_ReadReply' : 'S_Read' = 'Done' → 'oa.complete_str'[@rdOffice, @rdRes] | 'S_Read' = 'Idle' | 'S_Read' = 'Idle'

// T_ReadAbort：失败回执（@rdRes 含 ERR| 文本——失败侧也回执，Dog 可见失败原因）
§ 'T_ReadAbort' : 'S_Read' = 'Failed' → 'oa.complete_str'[@rdOffice, @rdRes] | 'S_Read' = 'Idle' | 'S_Read' = 'Idle'

// ══════════════ text.write 线 ══════════════

// T_WriteClaim：探测真 + Idle → 原子接单
§ 'T_WriteClaim' : @wrOpen & 'S_Write' = 'Idle' → 'oa.claim_next_simple'["TOOL", "text.write"] > @wrOffice | 'S_Write' = 'Claimed' | 'S_Write' = 'Idle'

// T_WriteArgs：读载荷 args
§ 'T_WriteArgs' : 'S_Write' = 'Claimed' → 'oa.get_str'[@wrOffice, "args"] > @wrArgs | 'S_Write' = 'Ready' | 'S_Write' = 'Failed'

// T_WriteExec：执行积木
§ 'T_WriteExec' : 'S_Write' = 'Ready' → 'text.write'[@wrArgs] > @wrRes | 'S_Write' = 'Done' | 'S_Write' = 'Failed'

// T_WriteReply：成功回执
§ 'T_WriteReply' : 'S_Write' = 'Done' → 'oa.complete_str'[@wrOffice, @wrRes] | 'S_Write' = 'Idle' | 'S_Write' = 'Idle'

// T_WriteAbort：失败回执
§ 'T_WriteAbort' : 'S_Write' = 'Failed' → 'oa.complete_str'[@wrOffice, @wrRes] | 'S_Write' = 'Idle' | 'S_Write' = 'Idle'

// ══════════════ text.append 线 ══════════════

// T_AppendClaim：探测真 + Idle → 原子接单
§ 'T_AppendClaim' : @apOpen & 'S_Append' = 'Idle' → 'oa.claim_next_simple'["TOOL", "text.append"] > @apOffice | 'S_Append' = 'Claimed' | 'S_Append' = 'Idle'

// T_AppendArgs：读载荷 args
§ 'T_AppendArgs' : 'S_Append' = 'Claimed' → 'oa.get_str'[@apOffice, "args"] > @apArgs | 'S_Append' = 'Ready' | 'S_Append' = 'Failed'

// T_AppendExec：执行积木
§ 'T_AppendExec' : 'S_Append' = 'Ready' → 'text.append'[@apArgs] > @apRes | 'S_Append' = 'Done' | 'S_Append' = 'Failed'

// T_AppendReply：成功回执
§ 'T_AppendReply' : 'S_Append' = 'Done' → 'oa.complete_str'[@apOffice, @apRes] | 'S_Append' = 'Idle' | 'S_Append' = 'Idle'

// T_AppendAbort：失败回执
§ 'T_AppendAbort' : 'S_Append' = 'Failed' → 'oa.complete_str'[@apOffice, @apRes] | 'S_Append' = 'Idle' | 'S_Append' = 'Idle'

// ══════════════ text.replace 线 ══════════════

// T_ReplaceClaim：探测真 + Idle → 原子接单
§ 'T_ReplaceClaim' : @rpOpen & 'S_Replace' = 'Idle' → 'oa.claim_next_simple'["TOOL", "text.replace"] > @rpOffice | 'S_Replace' = 'Claimed' | 'S_Replace' = 'Idle'

// T_ReplaceArgs：读载荷 args
§ 'T_ReplaceArgs' : 'S_Replace' = 'Claimed' → 'oa.get_str'[@rpOffice, "args"] > @rpArgs | 'S_Replace' = 'Ready' | 'S_Replace' = 'Failed'

// T_ReplaceExec：执行积木
§ 'T_ReplaceExec' : 'S_Replace' = 'Ready' → 'text.replace'[@rpArgs] > @rpRes | 'S_Replace' = 'Done' | 'S_Replace' = 'Failed'

// T_ReplaceReply：成功回执
§ 'T_ReplaceReply' : 'S_Replace' = 'Done' → 'oa.complete_str'[@rpOffice, @rpRes] | 'S_Replace' = 'Idle' | 'S_Replace' = 'Idle'

// T_ReplaceAbort：失败回执
§ 'T_ReplaceAbort' : 'S_Replace' = 'Failed' → 'oa.complete_str'[@rpOffice, @rpRes] | 'S_Replace' = 'Idle' | 'S_Replace' = 'Idle'

// ══════════════ mau.verify 线 ══════════════

// T_VerifyClaim：探测真 + Idle → 原子接单
§ 'T_VerifyClaim' : @vfOpen & 'S_Verify' = 'Idle' → 'oa.claim_next_simple'["TOOL", "mau.verify"] > @vfOffice | 'S_Verify' = 'Claimed' | 'S_Verify' = 'Idle'

// T_VerifyArgs：读载荷 args
§ 'T_VerifyArgs' : 'S_Verify' = 'Claimed' → 'oa.get_str'[@vfOffice, "args"] > @vfArgs | 'S_Verify' = 'Ready' | 'S_Verify' = 'Failed'

// T_VerifyExec：执行积木
§ 'T_VerifyExec' : 'S_Verify' = 'Ready' → 'mau.verify'[@vfArgs] > @vfRes | 'S_Verify' = 'Done' | 'S_Verify' = 'Failed'

// T_VerifyReply：成功回执（诊断文本/OK 确认）
§ 'T_VerifyReply' : 'S_Verify' = 'Done' → 'oa.complete_str'[@vfOffice, @vfRes] | 'S_Verify' = 'Idle' | 'S_Verify' = 'Idle'

// T_VerifyAbort：失败回执（FAIL|VALIDATE 诊断或 ERR| 错误）
§ 'T_VerifyAbort' : 'S_Verify' = 'Failed' → 'oa.complete_str'[@vfOffice, @vfRes] | 'S_Verify' = 'Idle' | 'S_Verify' = 'Idle'

// ══════════════ mau.gen 线 ══════════════

// T_GenClaim：探测真 + Idle → 原子接单
§ 'T_GenClaim' : @gnOpen & 'S_Gen' = 'Idle' → 'oa.claim_next_simple'["TOOL", "mau.gen"] > @gnOffice | 'S_Gen' = 'Claimed' | 'S_Gen' = 'Idle'

// T_GenArgs：读载荷 args
§ 'T_GenArgs' : 'S_Gen' = 'Claimed' → 'oa.get_str'[@gnOffice, "args"] > @gnArgs | 'S_Gen' = 'Ready' | 'S_Gen' = 'Failed'

// T_GenExec：执行积木（组翻译——中间产物不编译）
§ 'T_GenExec' : 'S_Gen' = 'Ready' → 'mau.gen'[@gnArgs] > @gnRes | 'S_Gen' = 'Done' | 'S_Gen' = 'Failed'

// T_GenReply：成功回执
§ 'T_GenReply' : 'S_Gen' = 'Done' → 'oa.complete_str'[@gnOffice, @gnRes] | 'S_Gen' = 'Idle' | 'S_Gen' = 'Idle'

// T_GenAbort：失败回执
§ 'T_GenAbort' : 'S_Gen' = 'Failed' → 'oa.complete_str'[@gnOffice, @gnRes] | 'S_Gen' = 'Idle' | 'S_Gen' = 'Idle'

// ══════════════ mau.proj 线 ══════════════

// T_ProjClaim：探测真 + Idle → 原子接单
§ 'T_ProjClaim' : @pjOpen & 'S_Proj' = 'Idle' → 'oa.claim_next_simple'["TOOL", "mau.proj"] > @pjOffice | 'S_Proj' = 'Claimed' | 'S_Proj' = 'Idle'

// T_ProjArgs：读载荷 args
§ 'T_ProjArgs' : 'S_Proj' = 'Claimed' → 'oa.get_str'[@pjOffice, "args"] > @pjArgs | 'S_Proj' = 'Ready' | 'S_Proj' = 'Failed'

// T_ProjExec：执行积木（组翻译 + dotnet build——长耗时）
§ 'T_ProjExec' : 'S_Proj' = 'Ready' → 'mau.proj'[@pjArgs] > @pjRes | 'S_Proj' = 'Done' | 'S_Proj' = 'Failed'

// T_ProjReply：成功回执
§ 'T_ProjReply' : 'S_Proj' = 'Done' → 'oa.complete_str'[@pjOffice, @pjRes] | 'S_Proj' = 'Idle' | 'S_Proj' = 'Idle'

// T_ProjAbort：失败回执
§ 'T_ProjAbort' : 'S_Proj' = 'Failed' → 'oa.complete_str'[@pjOffice, @pjRes] | 'S_Proj' = 'Idle' | 'S_Proj' = 'Idle'