// ══════════════ mau.proj 线 ══════════════

// T_ProjClaim：探测真 + Idle → 原子接单
§ 'T_ProjClaim' : @pjOpen & 'S_Proj' = 'Idle' → 'oa.claim_next_simple'["TOOL", "mau.proj"] > @pjOffice | 'S_Proj' = 'Claimed' | 'S_Proj' = 'Idle'

// T_ProjArgs：读载荷 args
§ 'T_ProjArgs' : 'S_Proj' = 'Claimed' → 'oa.get_str'[@pjOffice, "args"] > @pjArgs | 'S_Proj' = 'Ready' | 'S_Proj' = 'Failed'

// T_ProjExec：执行积木（组翻译 + dotnet build——长耗时）
§ 'T_ProjExec' : 'S_Proj' = 'Ready' → 'mau.proj'[@pjArgs] > @pjRes | 'S_Proj' = 'Done' | 'S_Proj' = 'Failed'

// T_ProjReply：成功回执（[!] 日志标记——热重载行为验证点）
§ 'T_ProjReply' [!] : 'S_Proj' = 'Done' → 'oa.complete_str'[@pjOffice, @pjRes] | 'S_Proj' = 'Idle' | 'S_Proj' = 'Idle'

// T_ProjAbort：失败回执
§ 'T_ProjAbort' : 'S_Proj' = 'Failed' → 'oa.complete_str'[@pjOffice, @pjRes] | 'S_Proj' = 'Idle' | 'S_Proj' = 'Idle'

// ══════════════ P8 三期 cs.* 编码工具认领线（9 线——csharp.bridge 单积木 PACK 协议分派；method=工具名去 cs. 前缀）══════════════
// 与一期 7 线同构：oa.is_open 探测 → claim_next_simple 原子接单 → get_str 读载荷 → csharp.bridge[method] 直执 → complete_str 回执
// 失败侧 ERR| 文本也在结果盒——Dog 可见失败原因；bridge 未注入时积木返回 false + ERR|CSHARP_NO_BRIDGE（失败侧回执同样可见）

// —— 状态机（9 线——每线独立生命周期）
§ 'S_Check' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Build' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_List' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CsRead' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_FindRef' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Patch' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Member' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Comment' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Dead' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// —— 主动传感器壳——9 线各自探测（officeName = 完整工具名）
§ 'P_CheckOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.check"] > @ckOpen
§ 'P_BuildOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.build"] > @buOpen
§ 'P_ListOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.list"] > @liOpen
§ 'P_CsReadOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.read"] > @csOpen
§ 'P_FindRefOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.find_ref"] > @frOpen
§ 'P_PatchOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.patch"] > @ptOpen
§ 'P_MemberOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.member"] > @mbOpen
§ 'P_CommentOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.comment"] > @cmOpen
§ 'P_DeadOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs.dead"] > @ddOpen

// ══════════════ cs.check 线 ══════════════
§ 'T_CheckClaim' : @ckOpen & 'S_Check' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs.check"] > @ckOffice | 'S_Check' = 'Claimed' | 'S_Check' = 'Idle'
§ 'T_CheckArgs' : 'S_Check' = 'Claimed' → 'oa.get_str'[@ckOffice, "args"] > @ckArgs | 'S_Check' = 'Ready' | 'S_Check' = 'Failed'
§ 'T_CheckExec' : 'S_Check' = 'Ready' → 'csharp.bridge'["check", @ckArgs] > @ckRes | 'S_Check' = 'Done' | 'S_Check' = 'Failed'
§ 'T_CheckReply' : 'S_Check' = 'Done' → 'oa.complete_str'[@ckOffice, @ckRes] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'
§ 'T_CheckAbort' : 'S_Check' = 'Failed' → 'oa.complete_str'[@ckOffice, @ckRes] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'

