// audio_cat.mau —— AudioCat 语料（AUDIO 域工具组 Flow）
// 角色：工具组 Flow——认领 TOOL 域 audio-* 工具（audio-play 本地 WAV 播放 / audio-speak 文本转语音并播放）
// 单级 OA 单：Dog Post → 本 Flow 认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名；载荷 key "args" = 整包工具参数 JSON（key/path/volume 或 text/voice/speed/key）
// 数据面：@adOffice 等私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型：收单/读参/回执主线程同步；audio-play 执行积木入队即返回（调度在服务内，主线程零阻塞）
//   —— audio-speak 合成为同步往返（含冷启动），在 OA 工具轮内等待（单服务串行，不并发）
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）
// 变更（2026-10-14 A239）：新建——音频播放能力工具面（design-mau-audio）
// 变更（2026-10-15 A246）：新增 audio-speak 线——文本转语音并播放（Kokoro py 服务）

// ── 状态机（2 线——每线独立生命周期）──
§ 'S_Audio' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Speak' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// T_Init：启动初始化自述
§ 'T_Init' : 'S_Audio' = 'Init' → 'self.desc'["空闲待命", "", ""] | 'S_Audio' = 'Idle' | 'S_Audio' = 'Idle'

// ── 主动传感器壳——探测（纯只读判断积木 → bool 落盒）──
§ 'P_AudioOpen' ↻ [1]: 'oa.is_open'["TOOL", "audio-play"] > @adOpen
§ 'P_SpeakOpen' ↻ [1]: 'oa.is_open'["TOOL", "audio-speak"] > @adSpeakOpen

// ══════════════ audio-play 线 ══════════════

// T_Claim：探测真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_Claim' : @adOpen & 'S_Audio' = 'Idle' → 'oa.claim_next_simple'["TOOL", "audio-play"] > @adOffice | 'S_Audio' = 'Claimed' | 'S_Audio' = 'Idle'

// T_Args：读载荷 args（整包工具参数 JSON）+ 执行中自述（desc 前移——避免抢单失败回 Idle 的残留）
§ 'T_Args' : 'S_Audio' = 'Claimed' → 'oa.get_str'[@adOffice, "args"] > @adArgs | 'self.desc'["audio-play 执行中", "", ""] | 'S_Audio' = 'Ready' | 'S_Audio' = 'Failed'

// T_Exec：执行积木（argsJson 整包——积木内部解析；入队即返回，主线程零阻塞）
§ 'T_Exec' : 'S_Audio' = 'Ready' → 'audio.play'[@adArgs] > @adRes | 'S_Audio' = 'Done' | 'S_Audio' = 'Failed'

// T_Reply：成功回执（result = "OK|已入队"）
§ 'T_Reply' : 'S_Audio' = 'Done' → 'oa.complete_str'[@adOffice, @adRes] | 'self.desc'["空闲待命", "", ""] | 'S_Audio' = 'Idle' | 'S_Audio' = 'Idle'

// T_Abort：失败回执（@adRes 含 ERR| 文本——失败侧也回执，Dog 可见失败原因）
§ 'T_Abort' : 'S_Audio' = 'Failed' → 'oa.complete_str'[@adOffice, @adRes] | 'S_Audio' = 'Idle' | 'S_Audio' = 'Idle'

// ══════════════ audio-speak 线 ══════════════

// T_SpeakClaim：探测真 + Idle → 原子接单
§ 'T_SpeakClaim' : @adSpeakOpen & 'S_Speak' = 'Idle' → 'oa.claim_next_simple'["TOOL", "audio-speak"] > @adSpeakOffice | 'S_Speak' = 'Claimed' | 'S_Speak' = 'Idle'

// T_SpeakArgs：读载荷 args + 执行中自述
§ 'T_SpeakArgs' : 'S_Speak' = 'Claimed' → 'oa.get_str'[@adSpeakOffice, "args"] > @adSpeakArgs | 'self.desc'["audio-speak 执行中", "", ""] | 'S_Speak' = 'Ready' | 'S_Speak' = 'Failed'

// T_SpeakExec：执行积木（合成 + 播放；合成同步往返含冷启动，在途期间本线不接新单）
§ 'T_SpeakExec' : 'S_Speak' = 'Ready' → 'audio.speak'[@adSpeakArgs] > @adSpeakRes | 'S_Speak' = 'Done' | 'S_Speak' = 'Failed'

// T_SpeakReply：成功回执（result = "OK|产物路径"）
§ 'T_SpeakReply' : 'S_Speak' = 'Done' → 'oa.complete_str'[@adSpeakOffice, @adSpeakRes] | 'self.desc'["空闲待命", "", ""] | 'S_Speak' = 'Idle' | 'S_Speak' = 'Idle'

// T_SpeakAbort：失败回执
§ 'T_SpeakAbort' : 'S_Speak' = 'Failed' → 'oa.complete_str'[@adSpeakOffice, @adSpeakRes] | 'S_Speak' = 'Idle' | 'S_Speak' = 'Idle'
