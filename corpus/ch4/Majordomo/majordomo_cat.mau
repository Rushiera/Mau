// majordomo_cat.mau —— Majordomo 语料（CH4 宿主自更新工具组——BRIK-HOST-001 host.restart 登记面）
// 角色：工具组 Flow——认领 TOOL 域 majordomo-restart 1 工具（宿主自更新：部署 + 重启 + 回执注入）
// 特权组：仅默认会话（catId=majordomo）可见可调——宿主侧单点授权（design-ch4-host-restart §二）
// 单级 OA 单：Dog（宿主 ToolOrderDog 实体）Post → 本 Flow 1 线认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名（majordomo-restart）；载荷 key "args" = 整包工具参数 JSON（target/push）
// 数据面：@majOpen/@majOffice/@majArgs/@majRes 私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型：全部主线程同步——积木只落盒即返回；进程动作（接力拉起/自杀）在宿主侧（design-ch4-host-restart §四 4.2）
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）

// ── 状态机（1 线——majordomo-restart）──
§ 'S_Restart' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// T_Init：启动初始化自述——Init → Idle 首帧写"空闲待命"（R0.2 外观层：启动即有自述横幅）
§ 'T_Init' : 'S_Restart' = 'Init' → 'self.desc'["Majordomo 自更新空闲待命", "", ""] | 'S_Restart' = 'Idle' | 'S_Restart' = 'Idle'

// ── 主动传感器壳——1 线探测（纯只读判断积木 → bool 落盒）──
§ 'P_RestartOpen' ↻ [1]: 'oa.is_open'["TOOL", "majordomo-restart"] > @majOpen

// ══════════════ majordomo-restart 线 ══════════════

// T_RestartClaim：探测真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_RestartClaim' : @majOpen & 'S_Restart' = 'Idle' → 'oa.claim_next_simple'["TOOL", "majordomo-restart"] > @majOffice | 'S_Restart' = 'Claimed' | 'S_Restart' = 'Idle'

// T_RestartArgs：读载荷 args（整包工具参数 JSON——target/push）
§ 'T_RestartArgs' : 'S_Restart' = 'Claimed' → 'oa.get_str'[@majOffice, "args"] > @majArgs | 'S_Restart' = 'Ready' | 'S_Restart' = 'Failed'

// T_RestartRun：登记请求（只落盒即返回——不碰进程；失败侧 ERR 文本也在 @majRes）
§ 'T_RestartRun' : 'S_Restart' = 'Ready' → 'host.restart'[@majArgs] > @majRes | 'self.desc'["Majordomo 登记重启请求", "", ""] | 'S_Restart' = 'Done' | 'S_Restart' = 'Failed'

// T_RestartReply：成功回执（result=登记结论）
§ 'T_RestartReply' : 'S_Restart' = 'Done' → 'oa.complete_str'[@majOffice, @majRes] | 'self.desc'["Majordomo 自更新空闲待命", "", ""] | 'S_Restart' = 'Idle' | 'S_Restart' = 'Idle'

// T_RestartAbort：失败回执（@majRes 含 ERR| 文本——失败侧也回执，Dog 可见失败原因）
§ 'T_RestartAbort' : 'S_Restart' = 'Failed' → 'oa.complete_str'[@majOffice, @majRes] | 'S_Restart' = 'Idle' | 'S_Restart' = 'Idle'
