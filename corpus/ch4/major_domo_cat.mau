// major_domo_cat.mau —— MajorDomoCat 工具执行器（CH4 P5）
// 角色：会话中枢的工具执行——宿主调度 LLM（消息/前文/收敛在宿主 C#），本语料执行工具批
// Command 语义（分支拓扑——信号名即解析结果）：宿主解析 LLM tool_calls 后每线必投其一：
//   TOOL_Exec_Read / TOOL_Skip_Read / TOOL_Exec_Ask / TOOL_Skip_Ask
// 参数盒（宿主 SetText 落全局盒）：TOOL_Read_Path（读路径）/ TOOL_Ask_Content（问内容）
// 完成协议：结果落 llm_result_read/llm_result_ask → llm_tool_done="1"（宿主轮询读走后清盒）
// 双线拓扑：读线（ReadText 工单）+ 问线（QuickCat 工单）——单工具时另一线 Skip，双工具并发执行合流
// 线程模型：全部主线程同步（OA 动作）；QuickCat LLM 消费在其积木后台（llm.stream——主线程零阻塞）
// 观测：log.write TOOL 专属类别 + trace 埋点 + OA 机制专属 Log（帧号可回溯）

// ── 状态机 ──
§ 'S_Exec' = { 'Idle', 'Running' }
§ 'S_Read' = { 'Idle', 'Posted', 'Ready', 'Done', 'Skipped' }
§ 'S_Ask' = { 'Idle', 'Posted', 'Ready', 'Waiting', 'Done', 'Skipped' }

// ── Command 传感器（宿主投递——分支拓扑）──
§ 'P_BatchStart' ⇚ "TOOL_Batch_Start"
§ 'P_ExecRead' ⇚ "TOOL_Exec_Read"
§ 'P_SkipRead' ⇚ "TOOL_Skip_Read"
§ 'P_ExecAsk' ⇚ "TOOL_Exec_Ask"
§ 'P_SkipAsk' ⇚ "TOOL_Skip_Ask"
§ 'P_ReadPath' ⇚ "TOOL_Read_Path"
§ 'P_AskContent' ⇚ "TOOL_Ask_Content"

// ── 主动传感器壳——工单完成沿探测（done_ready：按槽独立状态——防旧 @rDone 残留误收集 + 双壳状态互扰）──
§ 'P_RDone' ↻ [1]: 'oa.done_ready'[@rOffice, "read"] > @rDone
§ 'P_QDone' ↻ [1]: 'oa.done_ready'[@qOffice, "ask"] > @qDone

// ── 批次生命周期 ──

// T_Begin：批次开始（BatchStart 沿——与 Exec/Skip 沿分离，无沿竞争；清残留 done 标志）
§ 'T_Begin' : 'P_BatchStart' & 'S_Exec' = 'Idle' → 'data.box_set_str'["global", "llm_tool_done", ""] | 'S_Exec' = 'Running' | 'S_Exec' = 'Idle'

// ── 读线 ──

// T_ReadPost：要读 → 上架 ReadText 工单（超时 600 帧——P2d 宿主帧率定后校准）
§ 'T_ReadPost' : 'P_ExecRead' & 'S_Read' = 'Idle' → 'oa.post'["TOOL", "ReadText", 600] > @rOffice | 'S_Read' = 'Posted' | 'S_Read' = 'Skipped'

// T_RSet：写载荷 path（全局盒 TOOL_Read_Path——宿主落盒）
§ 'T_RSet' : 'S_Read' = 'Posted' → 'oa.set_str'[@rOffice, "path", TOOL_Read_Path] | 'S_Read' = 'Ready' | 'S_Read' = 'Skipped'

// T_RCollect：终态到达 → 读回执 result（空 result = 超时或失败——输出侧可见）
§ 'T_RCollect' : @rDone & 'S_Read' = 'Ready' → 'oa.get_result_str'[@rOffice] > @rResult | 'S_Read' = 'Done' | 'S_Read' = 'Done'

// T_RFinish：读线完成 → 结果落盒 + 复位 Idle（@rResult 空 = 本批未读到——失败/超时可见）
§ 'T_RFinish' : 'S_Read' = 'Done' → 'data.box_set_str'["global", "llm_result_read", @rResult] | 'S_Read' = 'Idle' | 'S_Read' = 'Idle'

// T_ReadSkip：本批不读 → 结果落空 + 终态
§ 'T_ReadSkip' : 'P_SkipRead' & 'S_Read' = 'Idle' → 'data.box_set_str'["global", "llm_result_read", ""] | 'S_Read' = 'Skipped' | 'S_Read' = 'Skipped'

// T_ReadSkipDone：Skipped 复位 Idle（合流门——Skipped 线不阻塞批次完成）
§ 'T_ReadSkipDone' : 'S_Read' = 'Skipped' → 'log.write'["TOOL | ReadText | SKIP", 0, "TOOL"] | 'S_Read' = 'Idle' | 'S_Read' = 'Idle'

// ── 问线 ──

// T_AskPost：要问 → 上架 QuickCat 工单
§ 'T_AskPost' : 'P_ExecAsk' & 'S_Ask' = 'Idle' → 'oa.post'["TOOL", "QuickCat", 600] > @qOffice | 'S_Ask' = 'Posted' | 'S_Ask' = 'Skipped'

// T_QSetS：写载荷 system（固定 prompt——QuickCat 问答子工具）
§ 'T_QSetS' : 'S_Ask' = 'Posted' → 'oa.set_str'[@qOffice, "system", "你是QuickCat问答子工具。简洁直接回答用户问题。"] | 'S_Ask' = 'Ready' | 'S_Ask' = 'Skipped'

// T_QSetC：写载荷 content（全局盒 TOOL_Ask_Content——宿主落盒）
§ 'T_QSetC' : 'S_Ask' = 'Ready' → 'oa.set_str'[@qOffice, "content", TOOL_Ask_Content] | 'S_Ask' = 'Waiting' | 'S_Ask' = 'Skipped'

// T_QCollect：终态到达 → 读回执 result
§ 'T_QCollect' : @qDone & 'S_Ask' = 'Waiting' → 'oa.get_result_str'[@qOffice] > @qResult | 'S_Ask' = 'Done' | 'S_Ask' = 'Done'

// T_QFinish：问线完成 → 结果落盒 + 复位 Idle
§ 'T_QFinish' : 'S_Ask' = 'Done' → 'data.box_set_str'["global", "llm_result_ask", @qResult] | 'S_Ask' = 'Idle' | 'S_Ask' = 'Idle'

// T_AskSkip：本批不问 → 结果落空 + 终态
§ 'T_AskSkip' : 'P_SkipAsk' & 'S_Ask' = 'Idle' → 'data.box_set_str'["global", "llm_result_ask", ""] | 'S_Ask' = 'Skipped' | 'S_Ask' = 'Skipped'

// T_AskSkipDone：Skipped 复位 Idle
§ 'T_AskSkipDone' : 'S_Ask' = 'Skipped' → 'log.write'["TOOL | QuickCat | SKIP", 0, "TOOL"] | 'S_Ask' = 'Idle' | 'S_Ask' = 'Idle'

// ── 合流 ──

// T_Merge：双线都回 Idle（各自完成/跳过）+ 批次 Running → 置 done → 批次复位
// 声明顺序依赖：T_RFinish/T_QFinish/T_ReadSkipDone/T_AskSkipDone 在 T_Merge 前（同帧双线完成时顺序执行）
§ 'T_Merge' : 'S_Read' = 'Idle' & 'S_Ask' = 'Idle' & 'S_Exec' = 'Running' → 'data.box_set_str'["global", "llm_tool_done", "1"] | 'S_Exec' = 'Idle' | 'S_Exec' = 'Idle'
