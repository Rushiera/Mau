// ch4_toolposter.mau —— CH4 ToolPoster 发单链路 v2（状态机化：轮询→发单→回执→回填→收尾回环）
// 源：CH4_Cat_ToolPoster.mau（旧 v1：16 信号 + 14 变迁手写状态机）——v2 塌缩为 1 状态机 + 3 测量 + 8 控制律
// 结构：M_PollReq 每帧采样请求标记 → T_ReadReq 读请求包 → T_CreateNext 发单（游标）
//       → M_PollClosed/M_PollTimeout 双测量等回执 → T_ReadAll 读四键回执 → T_PushTool 回填 LLM 上下文
//       → T_Finish 关单回 Dispatch 下一单；游标越界 → T_Summarize 写 tools_done → T_ClearReq 清标记回 Polling
§'Mau' 2.0
§'Mau.Runtime' 2.0
§$'sessionKey'
§'S_Poster' = { 'Polling', 'Dispatch', 'WaitClosed', 'Collect', 'Finish', 'Summarize', 'ClearReq', 'Failed' }
§'P_ReqReady', 'P_Closed', 'P_Timeout'
§'M_PollReq'[ω=1]: 'P_ReqReady' := 'data.box_is'['sessionKey', "tool_req_flag", 1]
§'M_PollClosed'[ω=1]: 'P_Closed' := 'dog.is_closed'['dogId']
§'M_PollTimeout'[ω=1]: 'P_Timeout' := 'dog.is_timeout'['dogId']
§'T_ReadReq'[τ=5]: 'P_ReqReady' ∧ 'S_Poster' = 'Polling' + 'data.box_get_dic'['sessionKey', "tool_req"] → 'S_Poster' = 'Dispatch' | 'S_Poster' = 'Failed'
§'T_CreateNext'[τ=10]: 'S_Poster' = 'Dispatch' + 'tool.create_next'['dataJson', 'sessionKey', 300] → 'S_Poster' = 'WaitClosed' | 'S_Poster' = 'Summarize'
§'T_ReadAll'[τ=5]: 'P_Closed' ∧ 'S_Poster' = 'WaitClosed' + 'dog.collect_result'['dogId'] → 'S_Poster' = 'Collect' | 'S_Poster' = 'Failed'
§'T_TimeoutFinish'[τ=5]: 'P_Timeout' ∧ 'S_Poster' = 'WaitClosed' + 'dog.finish'['dogId'] → 'S_Poster' = 'Dispatch' | 'S_Poster' = 'Failed'
§'T_PushTool'[τ=5]: 'S_Poster' = 'Collect' + 'llm.ctx_push_tool'['session', 'callId', 'toolName', 'argsJson', 'result'] → 'S_Poster' = 'Finish' | 'S_Poster' = 'Failed'
§'T_Finish'[τ=5]: 'S_Poster' = 'Finish' + 'dog.finish'['dogId'] → 'S_Poster' = 'Dispatch' | 'S_Poster' = 'Failed'
§'T_Summarize'[τ=5]: 'S_Poster' = 'Summarize' + 'data.box_set'['sessionKey', "tools_done", 1] → 'S_Poster' = 'ClearReq' | 'S_Poster' = 'Failed'
§'T_ClearReq'[τ=5]: 'S_Poster' = 'ClearReq' + 'data.box_set'['sessionKey', "tool_req_flag", 0] → 'S_Poster' = 'Polling' | 'S_Poster' = 'Failed'
