// ch4_talkcat.mau —— CH4 TalkCat 主对话流 v2（状态机 + 嵌套 + 测量 + 工具委托 + 错误处理）
// 源：CH4_Cat_Talk.mau（旧 v1：60+ 信号 + 40+ 变迁手写状态机 507 行）——v2 塌缩为 2 状态机 + 4 测量 + 20 控制律
// 结构：Init → Idle 指令轮询 → cmd.match 4 路（stop/rollback/newsession/用户消息）→ 用户消息建链
//       → BuildMsg → BuildTools → Start（llm.completions 占 R_ReplySlot）→ 子机 Active 流式链
//       → 终态分类（错误优先 → 工具 → 正常完成）→ 工具委托 ToolPoster（DataBox 通道轮询）→ 回 BuildMsg
//       → Done/Failed → Reset 回 Idle
§'Mau' 2.0
§'Mau.Runtime' 2.0
§$'sessionKey', 'prompt', 'ownerId'
§'S_Talk' = { 'Idle', 'RouteCmd', 'Stop', 'Rollback', 'NewSession', 'UserMsg', 'PushUser', 'SaveUser', 'BuildMsg', 'BuildTools', 'Start', 'WaitTools', 'Done', 'Failed' }
§'S_Active' ∈ 'S_Talk.Active'
§'S_Active' = { 'Thinking', 'Streaming', 'PushStream', 'PushReasoning', 'PushStats', 'PushStatsLine', 'ToolWait', 'ToolFlag', 'ErrorFinish', 'ErrorRecord' }
§'P_Init', 'P_ChunkReady', 'P_Ended', 'P_Error', 'P_ToolsDone'
§'R_ReplySlot': 1
§⇐ 'P_Init'
§'M_Pump'[ω=1]: 'P_ChunkReady' := 'llm.read_chunk'['requestId']
§'M_CheckEnd'[ω=1]: 'P_Ended' := 'llm.is_end'['requestId']
§'M_CheckError'[ω=1]: 'P_Error' := 'llm.has_error'['requestId']
§'M_PollTools'[ω=1]: 'P_ToolsDone' := 'data.box_is'['sessionKey', "tools_done", 1]
§'T_Init'[τ=5]: 'P_Init' + 'llm.ctx_set_system'['sessionKey', 'prompt'] → 'S_Talk' = 'Idle' | 'S_Talk' = 'Failed'
§'T_CheckCmd'[ω=1, τ=5]: 'S_Talk' = 'Idle' + 'cmd.consume'['ownerId'] → 'S_Talk' = 'RouteCmd' | 'S_Talk' = 'Idle'
§'T_RouteCmd'[τ=5]: 'S_Talk' = 'RouteCmd' + 'cmd.match'['text', ["stop","rollback","newsession"]] → 'S_Talk' = 'Stop' | 'S_Talk' = 'Rollback' | 'S_Talk' = 'NewSession' | 'S_Talk' = 'UserMsg'
§'T_DoStop'[τ=5]: 'S_Talk' = 'Stop' + 'llm.finish'['requestId'] → 'S_Talk' = 'Idle' | 'S_Talk' = 'Failed'
§'T_DoRollback'[τ=5]: 'S_Talk' = 'Rollback' + 'llm.ctx_rollback'['sessionKey', 'checkpoint'] → 'S_Talk' = 'Idle' | 'S_Talk' = 'Failed'
§'T_DoNewSession'[τ=5]: 'S_Talk' = 'NewSession' + 'llm.ctx_clear'['sessionKey'] → 'S_Talk' = 'Idle' | 'S_Talk' = 'Failed'
§'T_Checkpoint'[τ=5]: 'S_Talk' = 'UserMsg' + 'llm.ctx_checkpoint'['sessionKey'] → 'S_Talk' = 'PushUser' | 'S_Talk' = 'Failed'
§'T_PushUser'[τ=5]: 'S_Talk' = 'PushUser' + 'llm.ctx_push_user'['sessionKey', 'text'] → 'S_Talk' = 'SaveUser' | 'S_Talk' = 'Failed'
§'T_SaveUser'[τ=5]: 'S_Talk' = 'SaveUser' + 'data.box_set_dic'['sessionKey', "last_user_text", 'text'] → 'S_Talk' = 'BuildMsg' | 'S_Talk' = 'Failed'
§'T_BuildMsg'[τ=5]: 'S_Talk' = 'BuildMsg' + 'llm.ctx_build_messages_json'['sessionKey'] → 'S_Talk' = 'BuildTools' | 'S_Talk' = 'Failed'
§'T_BuildTools'[τ=5]: 'S_Talk' = 'BuildTools' + 'cat.tools_json'['sessionKey'] → 'S_Talk' = 'Start' | 'S_Talk' = 'Failed'
§'T_Start'[τ=10]: 'S_Talk' = 'Start' ∧ 'R_ReplySlot' + 'llm.completions'["deepseek-v4-flash", 'messagesJson', 'toolsJson'] → 'S_Talk' = 'Active' | 'S_Talk' = 'Failed'
§'T_Classify'[ω=1, τ=5]: 'P_ChunkReady' ∧ 'P_Ended' → 'S_Active' = 'Streaming' | 'S_Active' = 'Thinking'
§'T_Error'[τ=5]: 'P_Error' ∧ 'S_Active' = 'Streaming' + 'llm.finish'['requestId'] → 'S_Active' = 'ErrorFinish' | 'S_Talk' = 'Failed'
§'T_ErrorRollback'[τ=5]: 'S_Active' = 'ErrorFinish' + 'llm.ctx_rollback'['sessionKey', 'checkpoint'] → 'S_Active' = 'ErrorRecord' | 'S_Talk' = 'Failed'
§'T_ErrorRecord'[τ=5]: 'S_Active' = 'ErrorRecord' + 'llm.ctx_push_assistant'['sessionKey', "请求失败，已回滚"] → 'S_Talk' = 'Done' | 'S_Talk' = 'Failed'
§'T_CheckTool'[τ=5]: 'S_Active' = 'Streaming' + 'llm.is_tool'['requestId'] → 'S_Active' = 'ToolWait' | 'S_Active' = 'PushStream'
§'T_PushToolReq'[τ=5]: 'S_Active' = 'ToolWait' + 'data.box_set_dic'['sessionKey', "tool_req", 'toolCallsJson'] → 'S_Active' = 'ToolFlag' | 'S_Talk' = 'Failed'
§'T_ToolFlag'[τ=5]: 'S_Active' = 'ToolFlag' + 'data.box_set'['sessionKey', "tool_req_flag", 1] → 'S_Talk' = 'WaitTools' | 'S_Talk' = 'Failed'
§'T_ToolsDone'[τ=5]: 'P_ToolsDone' ∧ 'S_Talk' = 'WaitTools' + 'data.box_set'['sessionKey', "tools_done", 0] → 'S_Talk' = 'BuildMsg' | 'S_Talk' = 'Failed'
§'T_PushStream'[τ=5]: 'S_Active' = 'PushStream' + 'llm.ctx_push_stream'['requestId', 'sessionKey'] → 'S_Active' = 'PushReasoning' | 'S_Talk' = 'Failed'
§'T_PushReasoning'[τ=5]: 'S_Active' = 'PushReasoning' + 'llm.ctx_push_reasoning'['requestId', 'sessionKey'] → 'S_Active' = 'PushStats' | 'S_Talk' = 'Failed'
§'T_PushStats'[τ=5]: 'S_Active' = 'PushStats' + 'llm.round_stats_text'['requestId', 'sessionKey'] → 'S_Active' = 'PushStatsLine' | 'S_Talk' = 'Failed'
§'T_PushStatsLine'[τ=5]: 'S_Active' = 'PushStatsLine' + 'llm.ctx_push_system'['sessionKey', 'text'] → 'S_Talk' = 'Done' | 'S_Talk' = 'Failed'
§'T_Reset'[τ=5]: 'S_Talk' = 'Done' ∨ 'S_Talk' = 'Failed' + 'llm.ctx_count'['sessionKey'] → 'S_Talk' = 'Idle' | 'S_Talk' = 'Failed'
