// tool_cat.mau —— 工具猫（CH4 试点 T1：读写工具组——file.read/file.write；Mau v2.0 语法）
§'Mau' 2.0
§'Mau.Runtime' 2.0
§'S_Tool' = { 'Idle', 'ReadDone', 'ReadFailed', 'WriteDone', 'WriteFailed' }
§$'path', 'content'
§'P_Read', 'P_Write'
§⇐ 'P_Read'['path']
§⇐ 'P_Write'['path', 'content']
§'T_Read': 'P_Read' + 'file.read'['path'] → 'S_Tool' = 'ReadDone' | 'S_Tool' = 'ReadFailed'
§'T_Write': 'P_Write' + 'file.write'['path', 'content'] → 'S_Tool' = 'WriteDone' | 'S_Tool' = 'WriteFailed'
