// sequence_flow.mau —— 序列组合流程（三步序列 SEQ 语法糖——编译期展开为隐式状态机；Mau v2.0 语法）
§'Mau' 2.0
§'Mau.Runtime' 2.0
§'S_Flow' = { 'Idle', 'A', 'B', 'C' }
§$'input', 'output'
§'P_Start'
§⇐ 'P_Start'['input', 'output']
§'T_Step1'[τ=100]: 'P_Start' + 'file.convert'['input', 'output'] → 'S_Flow' = 'A' | 'S_Flow' = 'Idle'
§'T_Step2'[τ=100]: 'S_Flow' = 'A' + 'file.convert'['input', 'output'] → 'S_Flow' = 'B' | 'S_Flow' = 'Idle'
§'T_Step3'[τ=100]: 'S_Flow' = 'B' + 'file.convert'['input', 'output'] → 'S_Flow' = 'C' | 'S_Flow' = 'Idle'
§'SEQ'['T_Step1' → 'T_Step2' → 'T_Step3']
