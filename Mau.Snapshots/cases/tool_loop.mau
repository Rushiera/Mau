// 工具循环——claim → exec → complete（ShellCat 原子编排形态提炼）
§ 'S_Loop' = { 'WaitWork', 'Executing', 'Closing', 'Done' }
§ 'P_Claimed' ⇐
§ 'P_CloseOk' ⇐
§ 'P_Q_Work' ↻ [1] 'data.box_is'["work"]
§ 'T_Claim' : 'P_Q_Work' & 'S_Loop' = 'WaitWork' → 'oa.claim'[] | 'S_Loop' = 'Executing' | 'S_Loop' = 'WaitWork'
§ 'T_Exec' [par] : 'P_Claimed' & 'S_Loop' = 'Executing' → 'shell.exec'["run"] | 'S_Loop' = 'Closing' | 'S_Loop' = 'Done'
§ 'T_Close' : 'P_CloseOk' & 'S_Loop' = 'Closing' → 'oa.complete'[] | 'S_Loop' = 'WaitWork' | 'S_Loop' = 'Done'
