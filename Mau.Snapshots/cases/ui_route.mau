// UI 双状态机正交——窗口态 × 聊天态（UiPet 形态提炼；嵌套退役——正交组合）
§ 'S_Win' = { 'Home', 'Chat', 'Config' }
§ 'S_Chat' = { 'Idle', 'Streaming', 'Done' }
§ 'P_OpenChat' ⇐
§ 'P_OpenConfig' ⇐
§ 'P_StreamEnd' ⇐
§ 'T_ToChat' : 'P_OpenChat' & 'S_Win' = 'Home' → | 'S_Win' = 'Chat' | 'S_Win' = 'Home'
§ 'T_ToConfig' : 'P_OpenConfig' & 'S_Win' = 'Home' → | 'S_Win' = 'Config' | 'S_Win' = 'Home'
§ 'T_Stream' : 'P_OpenChat' & 'S_Chat' = 'Idle' → 'probe.sink'["stream", 0] | 'S_Chat' = 'Streaming' | 'S_Chat' = 'Done'
§ 'T_End' : 'P_StreamEnd' & 'S_Chat' = 'Streaming' → | 'S_Chat' = 'Done' | 'S_Chat' = 'Streaming'
