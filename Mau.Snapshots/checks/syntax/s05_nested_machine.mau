// s05 语法谱——状态机嵌套（层级 OR + None 哨兵）
// 特性：子机绑定父状态，父进子置/父离子清
§'Mau' 2.0
§'Mau.Runtime' 2.0
§'S_Talk' = { 'Idle', 'Active', 'Done', 'Failed' }
§'S_Active' ∈ 'S_Talk.Active'
§'S_Active' = { 'Thinking', 'Streaming' }
§'P_Go', 'P_Chunk'
§⇐ 'P_Go'
§'M_Poll'[ω=1]: 'P_Chunk' := 'data.box_is'['key', 'flag', 1]
§'T_Go'[τ=5]: 'P_Go' + 'file.convert'['src', 'dst'] → 'S_Talk' = 'Active' | 'S_Talk' = 'Failed'
§'T_Stream'[τ=5]: 'S_Active' = 'Thinking' ∧ 'P_Chunk' → 'S_Active' = 'Streaming' | 'S_Active' = 'Thinking'
§'T_Done'[τ=5]: 'S_Active' = 'Streaming' → 'S_Talk' = 'Done' | 'S_Talk' = 'Failed'
