// s01 语法谱——测量写条件（感知与决策分离）
// 特性：M_ 周期采样写条件命题，控制律引用条件触发
§'Mau' 2.0
§'Mau.Runtime' 2.0
§'S_Run' = { 'Idle', 'Done', 'Failed' }
§'P_Go', 'P_Ready'
§⇐ 'P_Go'
§'M_Poll'[ω=1]: 'P_Ready' := 'data.box_is'['key', 'flag', 1]
§'T_Run'[τ=5]: 'P_Go' ∧ 'P_Ready' + 'file.convert'['src', 'dst'] → 'S_Run' = 'Done' | 'S_Run' = 'Failed'
