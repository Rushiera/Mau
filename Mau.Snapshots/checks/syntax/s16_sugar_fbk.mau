// s16 语法谱——FBK 语法糖（反馈闭环）
// 特性：状态自环 + 测量写条件（1 路结果——无失败分支，FBK 追加 Working）
§'Mau' 2.0
§'Mau.Runtime' 2.0
§'S_Work' = { 'Idle', 'Done' }
§'P_Go', 'P_Ready'
§⇐ 'P_Go'
§'M_Poll'[ω=1]: 'P_Ready' := 'data.box_is'['key', 'flag', 1]
§'T_Work'[τ=5]: 'P_Ready' ∧ 'P_Go' + 'file.convert'['src', 'dst'] → 'S_Work' = 'Done'
§'FBK'['M_Poll' → 'T_Work' → 'M_Poll']
