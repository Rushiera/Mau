// s20 语法谱——轮询组合完整形态（TalkCat 片段）
// 特性：测量 + 状态机 + 嵌套（父状态隐式加入 + 子机激活初始）
§'Mau' 2.0
§'Mau.Runtime' 2.0
§'S_Talk' = { 'Idle', 'Building', 'Done', 'Failed' }
§'S_Active' ∈ 'S_Talk.Active'
§'S_Active' = { 'Thinking', 'Streaming', 'ToolWait' }
§'P_Init', 'P_ChunkReady'
§⇐ 'P_Init'
§'M_Pump'[ω=1]: 'P_ChunkReady' := 'llm.read_chunk'['requestId']
§'T_Init'[τ=5]: 'P_Init' + 'llm.ctx_set_system'['sessionKey', 'prompt'] → 'S_Talk' = 'Building' | 'S_Talk' = 'Failed'
§'T_Start'[τ=10]: 'S_Talk' = 'Building' + 'llm.completions'['model', 'messagesJson', 'toolsJson'] → 'S_Talk' = 'Active' | 'S_Talk' = 'Failed'
§'T_Classify'[ω=1, τ=5]: 'P_ChunkReady' + 'llm.is_end'['requestId'] → 'S_Active' = 'Streaming' | 'S_Active' = 'Thinking'
§'T_CheckTool'[τ=5]: 'S_Active' = 'Streaming' + 'llm.is_tool'['requestId'] → 'S_Active' = 'ToolWait' | 'S_Active' = 'Thinking'
§'T_Finish'[τ=5]: 'S_Active' = 'Streaming' → 'S_Talk' = 'Done'
